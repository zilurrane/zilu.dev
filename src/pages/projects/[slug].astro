---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}))}
const {project}=Astro.props;
const url='https://zilu.dev/projects/'+project.slug+'/';
---
<Base title={project.title+' — Project Case Study | Zilu Rane'} description={project.description} canonical={url} schema={{'@type':'SoftwareSourceCode',name:project.title,url,description:project.description,author:{'@id':'https://zilu.dev/#person'},codeRepository:project.url}}>
<article class="wrap mock-prose"><nav class="breadcrumb"><a href="/">Home</a> / <a href="/projects/">Projects</a> / {project.title}</nav><p class="mock-kicker">{project.category}</p><h1>{project.title}</h1><p class="muted" style="font-size:1.22rem">{project.description}</p><div class="skill-row">{project.stack.map(s=><span>{s}</span>)}</div><ProjectVisual project={project}/><p style="margin:28px 0"><a href={project.url} target="_blank" rel="noopener noreferrer" class="btn primary">View actual repository ↗</a></p><section><h2>The problem</h2><p>{project.problem}</p><h2>Architecture & approach</h2><p>{project.approach}</p><h2>Technology and trade-offs</h2><p>This repository demonstrates a practical approach using {project.stack.join(', ')}. Explore the source and documentation for implementation details, constraints and current project status.</p><h2>Explore the source</h2><p>For accurate and up-to-date behavior, setup steps and implementation details, see the <a href={project.url} style="color:var(--orange);text-decoration:underline">GitHub repository</a>.</p></section></article>
</Base>
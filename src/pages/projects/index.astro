---
import Base from '../../layouts/Base.astro';
import {projects} from '../../data/projects';
import ProjectVisual from '../../components/ProjectVisual.astro';
import PrivateProjectPreview from '../../components/PrivateProjectPreview.astro';
---
<Base title="Engineering Projects | Zilu Rane" description="Explore engineering case studies, developer tooling, open-source projects and full-stack applications by Zilu Rane." canonical="https://zilu.dev/projects/" schema={{'@type':'CollectionPage',name:'Engineering Projects by Zilu Rane',url:'https://zilu.dev/projects/'}}>
<div class="wrap"><header class="mock-subhero"><p class="mock-kicker">PORTFOLIO / CASE STUDIES</p><h1>Engineering work,<br/><span class="mock-gradient-text">built with intention.</span></h1><p>Engineering case studies and open-source repositories. Each overview covers the problem, approach and technology without invented outcomes.</p></header><section class="mock-content-grid" aria-label="Engineering projects">{projects.map(p=><a href={'/projects/'+p.slug+'/'} class="mock-content-card"><p class="mock-kicker">{p.category}</p><h2>{p.title} ↗</h2><p>{p.description}</p><div class="mock-chips">{p.stack.map(t=><span>{t}</span>)}</div>{p.url?<ProjectVisual project={p}/>:<PrivateProjectPreview slug={p.slug}/>}</a>)}</section></div>
</Base>
---
import Base from '../layouts/Base.astro';
import {projects} from '../data/projects';
import editions from '../../news/briefings.json';
const edition=[...editions].sort((a,b)=>b.date.localeCompare(a.date))[0];
---
<Base title="Zilu Rane | Full-Stack Engineer, AI Agents & Developer Tools" description="Engineering portfolio of Zilu Rane in Pune, India. Explore real open-source projects, AI agents, full-stack JavaScript, technical writing and daily tech news." canonical="https://zilu.dev/" schema={{'@type':'ProfilePage',mainEntity:{'@id':'https://zilu.dev/#person'}}}>
<div class="wrap"><section class="hero"><div><p class="eyebrow"><span class="accent">✦</span> Technical Lead · Accion Labs · Pune, India</p><h1>Engineering <span class="accent">useful things</span> for the real world.</h1><p class="lead">I'm Zilu Rane, a Technical Lead at Accion Labs with 9+ years of experience in full-stack development. I build web products, developer tools and AI-powered systems with React, Node.js, LangChain and cloud platforms.</p><p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a href="/projects/" class="btn primary">Explore my work ↗</a><a href="/writing/" class="btn">Read the journal ↗</a></p><div class="skill-row" style="margin-top:35px"><span>Full-stack</span><span>AI agents & RAG</span><span>Developer tools</span><span>Cloud & infrastructure</span></div></div><div class="dark-panel"><div class="window-dots"><i></i><i></i><i></i><small style="margin-left:12px;color:#a1a9a6">currently building / edge automation</small></div><p class="eyebrow" style="color:#9ed0b8">Featured architecture</p><h2 style="color:white">LinkedIn Signal Agent</h2><p style="color:#b8c2c0">Technology signals ranked with Workers AI, deduplicated and delivered as a daily digest.</p><div class="flow-steps" style="margin:32px 0"><span>RSS & GitHub</span><b>→</b><span>Workers AI</span><b>→</b><span>Daily digest</span></div><p class="mono mini" style="color:#9ed0b8">TypeScript · Workers AI · Cloudflare KV</p><a href="/projects/linkedin-signal-agent/" style="color:#ed9976">View case study ↗</a></div></section>
<section class="section" id="work"><div class="section-header"><h2>Featured work</h2><a href="/projects/" class="accent mini">All projects ↗</a></div><div class="grid">{projects.slice(0,3).map(p=><a href={'/projects/'+p.slug+'/'} class="card"><span class="eyebrow">{p.category}</span><h3>{p.title} ↗</h3><p>{p.description}</p><div class="tags">{p.stack.slice(0,3).map(t=><span class="tag">{t}</span>)}</div></a>)}</div></section>
<section class="section"><div class="split"><div><div class="section-header"><h2>From the journal</h2><a href="/writing/" class="accent mini">All writing ↗</a></div><div class="item"><a href="https://dev.to/zilurrane/express-js-cors-middleware-unable-to-store-cookies-on-browser-55g6">Express CORS middleware unable to store cookies in the browser ↗</a><p class="muted mini">Practical debugging notes · JavaScript</p></div><div class="item"><a href="https://dev.to/zilurrane/playing-and-learning-docker-together-45p5">Playing and learning Docker together ↗</a><p class="muted mini">Docker fundamentals · Engineering</p></div></div><div><div class="section-header"><h2>Daily tech news</h2><a href="/news/" class="accent mini">Latest briefing ↗</a></div><p class="eyebrow">{edition?.date ?? 'Technology briefing'} · 5 curated stories</p>{edition?.stories.slice(0,5).map((s,i)=><div class="item"><span class="news-number">{String(i+1).padStart(2,'0')}</span><a href={`/news/${edition.date}-daily-tech-news/`}>{s.headline}</a></div>)}</div></div></section>
<section class="section"><div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap"><div><p class="eyebrow">Open to meaningful conversations</p><h2 style="margin-bottom:0">Let's build something useful.</h2><p>Engineering, AI workflows, architecture or open-source collaboration.</p></div><a class="btn primary" href="mailto:zilurrane@gmail.com">Get in touch ↗</a></div></section></div>
</Base>
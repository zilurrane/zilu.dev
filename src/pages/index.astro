---
import NeoLayout from '../layouts/NeoLayout.astro';
import editions from '../../news/briefings.json';
const edition=[...editions].sort((a,b)=>b.date.localeCompare(a.date))[0];
const stories=edition?.stories.slice(0,3)??[];
const displayDate=edition?new Date(edition.date+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).toUpperCase():'';
---
<NeoLayout
  title="Zilu Rane | Full-Stack Engineer & Developer Tools"
  description="Explore Zilu Rane’s full-stack engineering projects, developer tools, technical writing and source-linked daily technology briefings."
  canonical="https://zilu.dev/"
  schema={{'@type':'ProfilePage',mainEntity:{'@id':'https://zilu.dev/#person'}}}
>

  <div class="site-width site-announcement"><span><b>✳ SOFTWARE · SYSTEMS · IDEAS</b> &nbsp; Engineering notes, selected work and daily tech news</span><span aria-hidden="true">01 / 02 ↗</span></div>
  <section class="site-width hero" aria-labelledby="hero-title"><div class="hero-copy">
    <div class="hero-ribbon"><span>HELLO WORLD!</span> I'M ZILU RANE ✳</div>
    <h1 id="hero-title">I build<br>software that<br><span class="highlight">makes sense.</span></h1>
    <p class="hero-lead">Full-stack engineer crafting developer tools, scalable platforms and useful AI-powered experiences. Thoughtful code, human-friendly interfaces.</p>
    <div class="hero-cta"><a class="btn primary" href="#selected-work">Explore my work <span aria-hidden="true">↗</span></a><a class="btn" href="/news/">Read my daily tech news <span aria-hidden="true">→</span></a></div>
    <div class="hero-after"><span class="mini-dash"></span> JAVASCRIPT / JAVA / AI / SYSTEM DESIGN</div>
  </div><div class="portrait-card" ><div class="portrait-orbit"></div><img class="portrait" src="/images/zilu-portrait-2026-hd.webp" alt="Portrait of Zilu Rane wearing glasses and a navy blue shirt" width="1254" height="1254" loading="eager" decoding="async" fetchpriority="high"><div class="portrait-top"><span class="portrait-dot"></span> PEOPLE FIRST. CODE SECOND.</div><div class="portrait-sticker">BUILD ✳ SHIP ✳ LEARN</div><div class="portrait-bottom"><span class="pill">☕ Turning ideas into products</span><span class="micro">EST. IN CODE</span></div></div></section>
  <section class="site-width quick-cards" aria-label="At a glance"><div class="quick-card"><span>01 / Experience</span><b>9+ years</b><span class="small-cap">Engineering & building</span></div><div class="quick-card"><span>02 / Specialty</span><b>Full stack</b><span class="small-cap">From pixels to platforms</span></div><div class="quick-card"><span>03 / Mindset</span><b>Keep shipping.</b><span class="small-cap">Practical beats complicated</span></div></section>
  <section id="selected-work" class="site-width projects" aria-labelledby="projects-title"><div class="section-top"><div><div class="section-overline">GOOD IDEAS, BUILT WELL</div><h2 class="section-title" id="projects-title">Selected work<span class="rotated-star"> ✳</span></h2><p class="section-note">Some things I've built, improved or helped bring to life.</p></div><span class="tiny-pill accent-blue">PROJECTS / 02</span></div>
  <div class="projects-grid">
    <a class="card project punch-lift" href="/projects/querydeck/"><div class="project-top"><div><span class="project-num">01 / DEVELOPER TOOLING</span><h3>QueryDeck</h3><p class="project-desc">A lightweight SQL workspace designed to make everyday database work feel a little less heavy.</p></div><span class="project-arrow">↗</span></div><div class="project-canvas canvas-sql" role="img" aria-label="Conceptual preview of SQL development interface"><div class="fake-window-top"><i></i><i></i><i></i><span>querydeck / editor.sql</span></div><div class="sql-layout"><div class="sql-sidebar"><div>⌄ DATABASE</div><div>▸ workspace</div><div>▸ saved queries</div><div>▸ history</div></div><div class="sql-editor"><div><span class="blue">SELECT</span> project, status</div><div><span class="blue">FROM</span> <span class="pink">my_work</span></div><div><span class="blue">WHERE</span> fun = <span class="pink">true</span>;</div><div class="sql-table"><span>project</span><span>type</span><span>status</span><span>QueryDeck</span><span>Desktop</span><span>active</span><span>Systems</span><span>Cloud</span><span>shipping</span></div></div></div></div><div class="project-bottom"><span class="tiny-pill">Electron</span><span class="tiny-pill">Angular</span><span class="tiny-pill">SQL Server</span></div></a>
    <a class="card project punch-lift" href="/projects/enterprise-applications/"><div class="project-top"><div><span class="project-num">02 / SYSTEMS ENGINEERING</span><h3>Enterprise platforms</h3><p class="project-desc">Large applications with complex workflows, clean APIs and maintainable architecture.</p></div><span class="project-arrow">↗</span></div><div class="project-canvas canvas-systems" role="img" aria-label="Conceptual diagram of browser, API and database"><div class="sys-app">✳ FRONTEND UI</div><div class="sys-flow"><span>↓</span><div class="sys-app center">API / BUSINESS LOGIC</div><span>↓</span></div><div class="sys-app">▥ DATA / CLOUD</div><span class="sys-tiny">CONCEPT VISUAL · NOT AN ACTUAL PRODUCT SCREENSHOT</span></div><div class="project-bottom"><span class="tiny-pill">Java</span><span class="tiny-pill">Spring Boot</span><span class="tiny-pill">Cloud</span></div></a>
  </div></section>
  <section class="site-width notes-area" aria-labelledby="news-preview-title"><div class="notes-copy"><div class="section-overline">FIVE LINKS. LESS NOISE.</div><h2 id="news-preview-title">One small dose<br>of <span class="highlight">tech news.</span></h2><p>A curated digest of AI, developer tooling, SaaS, security and what's happening in Indian tech. Written for people who actually build things.</p><a class="btn primary" href="/news/">Open the news page ↗</a><p class="micro" style="margin-top:16px">LATEST EDITION · <time datetime={edition?.date}>{displayDate}</time></p></div><div class="news-preview">
{edition && stories.map((story,i) => (
  <a class="news-preview-item" href={'/news/'+edition.date+'-daily-tech-news/#story-'+(i+1)}>
    <span class="news-index">{String(i+1).padStart(2,'0')}</span>
    <span><small><time datetime={edition.date}>{displayDate}</time> / {story.category.toUpperCase()}</small><strong>{story.headline}</strong></span>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
))}
</div></section>
  <aside class="site-width cta-panel" aria-label="Contact"><div><div class="micro" style="margin-bottom:7px">HAVE SOMETHING INTERESTING?</div><h2>Let's make something useful.</h2><p>Complex engineering problem, a product idea, or just a good conversation about code?</p></div><a class="btn" href="mailto:zilurrane@gmail.com?subject=Hello%20from%20your%20portfolio">Say hello ↗</a></aside>

</NeoLayout>

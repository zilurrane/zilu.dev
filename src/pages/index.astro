---
import Base from '../layouts/Base.astro';
import {projects} from '../data/projects';
import editions from '../../news/briefings.json';
const edition=[...editions].sort((a,b)=>b.date.localeCompare(a.date))[0];
const featured=projects.slice(0,3);
---
<Base title="Zilu Rane — Full-Stack Engineer | Projects, Writing & Daily Tech News" description="Explore Zilu Rane's full-stack engineering projects, technical writing and source-linked daily technology briefings." canonical="https://zilu.dev/" schema={{'@type':'ProfilePage',mainEntity:{'@id':'https://zilu.dev/#person'}}}>
<div class="mock-home wrap">
<section class="mock-hero" aria-labelledby="hero-title"><div class="mock-hero-copy"><p class="mock-kicker">SOFTWARE ENGINEER / INDIA</p><h1 id="hero-title">Building software <span class="mock-gradient-text">that makes sense.</span></h1><p>I design and build scalable applications, thoughtful interfaces, and practical AI-powered systems.</p><div class="mock-actions"><a class="mock-button" href="/projects/">Explore my work <span aria-hidden="true">→</span></a><a class="mock-button secondary" href="/writing/">Read my writing</a><a class="mock-icon-button" href="https://github.com/zilurrane" aria-label="GitHub profile">↗</a></div></div><div class="mock-hero-art" aria-hidden="true"><div class="mock-hero-grid"></div><div class="mock-orbit"></div><div class="mock-orbit mock-orbit-small"></div><div class="mock-code-card"><span class="mock-terminal-label">~/zilu.dev — portfolio</span><span class="mock-terminal-line">const engineer = {</span><span class="mock-terminal-line">  focus: "Full-stack",</span><span class="mock-terminal-line">  craft: "Thoughtful UI",</span><span class="mock-terminal-line">  mindset: "Ship & learn"</span><span class="mock-terminal-line">}; ▌</span></div><div class="mock-hero-caption">DESIGN × ENGINEERING × CURIOSITY</div></div></section>
<section class="mock-stats" aria-label="Engineering focus"><div><strong>9+ years</strong><span>Engineering experience</span></div><div><strong>Full-stack</strong><span>JavaScript · Java · Cloud</span></div><div><strong>Open source</strong><span>Developer tooling</span></div><div><strong>Mentorship</strong><span>Engineering & community</span></div></section>
<section class="mock-section" aria-labelledby="work-title"><div class="mock-section-heading"><div><p class="mock-kicker">SELECTED ENGINEERING</p><h2 id="work-title">Featured Work</h2><p>Projects I've built, maintained or contributed to.</p></div><a href="/projects/">View all projects →</a></div><div class="mock-project-grid">{featured.map((project,i)=><a class="mock-project" href={`/projects/${project.slug}/`}><div class="mock-project-top"><span class="mock-project-icon">{String(i+1).padStart(2,"0")} / 03</span><span aria-hidden="true">↗</span></div><h3>{project.title}</h3><p>{project.description}</p><div class="mock-chips">{project.stack.slice(0,3).map(s=><span>{s}</span>)}</div><div class="mock-project-preview"><strong>ENGINEERING / {String(i+1).padStart(2,"0")}</strong><span>{project.stack.slice(0,3).join(" → ")}</span></div></a>)}</div></section>
{edition&&<section class="mock-section" aria-labelledby="brief-title"><div class="mock-section-heading"><div><p class="mock-kicker">DAILY TECHNOLOGY BRIEFING</p><h2 id="brief-title">Five important stories. <span class="mock-gradient-text">Every morning.</span></h2><p>AI, developer tools, SaaS, cybersecurity and Indian technology.</p></div><a href="/news/">All editions →</a></div><div class="mock-news-list">{edition.stories.map((s,i)=><a href={`/news/${edition.date}-daily-tech-news/`} class="mock-news-row"><span class="mock-story-index">{String(i+1).padStart(2,'0')}</span><span class="mock-story-content"><small>{s.category} · <time datetime={edition.date}>{edition.date}</time></small><strong>{s.headline}</strong><span>{s.summary}</span></span><span class="mock-row-arrow" aria-hidden="true">→</span></a>)}</div></section>}
<section class="mock-section mock-cta"><p class="mock-kicker">LET'S BUILD SOMETHING USEFUL</p><h2>Thoughtful software. <span class="mock-gradient-text">Real impact.</span></h2><a class="mock-button" href="mailto:zilurrane@gmail.com">Get in touch →</a></section>
</div></Base>
 <article class="site-width neo-page">
  <nav class="neo-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/writing/">Writing</a><span aria-hidden="true">/</span><span aria-current="page">AI agents comparison</span></nav>

---
import NeoLayout from '../../layouts/NeoLayout.astro';
const articles=[
 {date:'2021-06-29',title:'Express CORS middleware unable to store cookies in the browser',desc:'Debugging credential handling and cross-origin cookies in Express applications.',url:'https://dev.to/zilurrane/express-js-cors-middleware-unable-to-store-cookies-on-browser-55g6',tag:'Node.js',label:'BACKEND'},
 {date:'2018-11-22',title:'Playing and learning Docker together',desc:'Notes for developers exploring Docker and container workflows.',url:'https://dev.to/zilurrane/playing-and-learning-docker-together-45p5',tag:'Docker',label:'DEVOPS'},
 {date:'2018-06-04',title:'Generate release-mode APK for a React Native project',desc:'Preparing an Android release build for publishing.',url:'https://dev.to/zilurrane/generate-release-mode-apk-for-react-native-project-to-publish-on-playstore-5f78',tag:'React Native',label:'MOBILE'}
];
const displayDate=(date)=>new Date(date+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<NeoLayout
 title="Technical Writing & Engineering Notes | Zilu Rane"
 description="Read practical engineering notes by Zilu Rane on Express CORS, Docker and React Native, plus daily sourced technology news."
 canonical="https://zilu.dev/writing/"
 schema={{'@type':'CollectionPage',name:'Technical Writing',url:'https://zilu.dev/writing/',author:{'@id':'https://zilu.dev/#person'},hasPart:articles.map(a=>({'@type':'BlogPosting',headline:a.title,url:a.url,datePublished:a.date}))}}
>
 <div class="site-width neo-page">
   <nav class="neo-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="slash" aria-hidden="true">/</span><span aria-current="page">Writing</span></nav>
   <header class="neo-intro">
     <div class="neo-intro-copy">
       <p class="neo-overline">NOTES FROM THE WORKBENCH / 02</p>
       <h1 class="neo-h1">Ideas worth<br/><span class="neo-highlight pink">sharing.</span></h1>
       <p class="neo-lede">Practical engineering notes from projects, experiments and things that didn't work the first time. Original articles are hosted on DEV Community.</p>
     </div>
     <div class="neo-issue pink" aria-hidden="true"><b>{String(articles.length).padStart(2,'0')}</b><span>PUBLISHED NOTES</span></div>
   </header>
   <div class="neo-toolbar"><p>WRITING / ENGINEERING NOTES / {articles.length} ARTICLES</p><a href="https://dev.to/zilurrane" target="_blank" rel="noopener noreferrer">Read on DEV ↗</a></div>
   <section class="neo-grid three" aria-label="Published technical articles">
     {articles.map((a,i)=><article class="neo-card neo-writing-card">
       <div class="neo-card-top"><span class="neo-number">{String(i+1).padStart(2,'0')}</span><span class="neo-pill">{a.tag}</span></div>
       <p class="article-date"><time datetime={a.date}>{displayDate(a.date)}</time> / {a.label}</p>
       <h2>{a.title}</h2>
       <p>{a.desc}</p>
       <a href={a.url} class="source" target="_blank" rel="noopener noreferrer" aria-label={'Read '+a.title+' on DEV Community'}>Read original article <span aria-hidden="true">↗</span></a>
     </article>)}
   </section>
   <section class="neo-section-block" aria-labelledby="briefing-title">
     <div class="neo-grid">
       <div class="neo-card neo-panel neo-reading">
         <p class="neo-overline">A DAILY READ</p>
         <h2 id="briefing-title" class="neo-section-heading">Fresh ideas, <span style="color:var(--orange)">every day.</span></h2>
         <p>Five source-linked technology developments covering AI, developer tooling, SaaS, cybersecurity, and Indian tech—each with an explanation of why it matters.</p>
         <a class="btn primary" href="/news/">Browse daily tech news ↗</a>
       </div>
       <div class="neo-card neo-panel neo-reading">
         <p class="neo-overline">OPEN SOURCE</p>
         <h2 class="neo-section-heading">Code behind the ideas.</h2>
         <p>Browse developer tools, learning projects and engineering case studies for a closer look at the implementation decisions.</p>
         <a class="btn" href="/projects/">Explore projects ↗</a>
       </div>
     </div>
   </section>
 </div>
</NeoLayout>

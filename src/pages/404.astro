---
import NeoLayout from '../layouts/NeoLayout.astro';
---
<NeoLayout
 title="Page Not Found (404) | Zilu Rane"
 description="That page isn't available. Browse Zilu Rane's engineering projects, technical writing and daily technology news."
 robots="noindex,follow"
>
 <section class="site-width neo-page neo-404" aria-labelledby="missing-title">
   <div>
     <p class="neo-overline">ERROR / NO ROUTE FOUND</p>
     <p class="neo-404-code" aria-hidden="true">4<span>0</span>4</p>
     <h1 id="missing-title" class="neo-h1">This page <span class="neo-highlight pink">escaped.</span></h1>
     <p>The URL might have moved, or it may never have existed. Here's a way back to the useful stuff.</p>
     <div class="hero-cta" style="justify-content:center">
       <a class="btn primary" href="/">Back to home <span aria-hidden="true">↗</span></a>
       <a class="btn" href="/projects/">Explore projects</a>
       <a class="btn" href="/news/">Daily news</a>
     </div>
   </div>
 </section>
</NeoLayout>

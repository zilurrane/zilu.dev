---
import Base from '../../layouts/Base.astro';
import editions from '../../../news/briefings.json';
export function getStaticPaths(){return editions.map(edition=>({params:{slug:edition.date+'-daily-tech-news'},props:{edition}}))}
const {edition}=Astro.props;const url='https://zilu.dev/news/'+edition.date+'-daily-tech-news/';
const displayDate=new Date(edition.date+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<Base title={`Daily Tech News — ${displayDate} | Zilu Rane`} description={edition.stories.map(s=>s.headline).slice(0,3).join('; ').slice(0,155)} canonical={url} type="article" schema={{'@type':'Article',headline:'Daily Tech News — '+displayDate,datePublished:edition.date,author:{'@id':'https://zilu.dev/#person'},publisher:{'@id':'https://zilu.dev/#person'},mainEntityOfPage:url,citation:edition.stories.map(s=>s.source_url),articleSection:edition.stories.map(s=>s.category)}}>
<article class="wrap mock-article"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/news/">News</a> / <time datetime={edition.date}>{edition.date}</time></nav><header><p class="mock-kicker">DAILY TECHNOLOGY BRIEFING · FIVE STORIES</p><h1>Daily Tech News<br/><span class="mock-gradient-text">{displayDate}</span></h1><p>Five source-linked stories, with concise summaries and why each matters.</p></header><div class="mock-article-body">{edition.stories.map((s,i)=><section class="mock-article-story" aria-labelledby={`story-${i}`}><p class="mock-kicker">{String(i+1).padStart(2,'0')} / {s.category}</p><h2 id={`story-${i}`}>{s.headline}</h2><p>{s.summary}</p><div class="mock-why"><strong>Why it matters</strong><p>{s.why_it_matters}</p></div><a class="mock-button secondary" href={s.source_url} target="_blank" rel="noopener noreferrer">Read original source ↗</a></section>)}</div><section class="mock-article-sources"><h2>Sources & citations</h2><ol>{edition.stories.map(s=><li><a href={s.source_url} target="_blank" rel="noopener noreferrer">{s.headline} ↗</a></li>)}</ol></section></article>
</Base>
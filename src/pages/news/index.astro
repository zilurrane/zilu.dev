---
import NeoLayout from '../../layouts/NeoLayout.astro';
import NeoNews from '../../components/NeoNews.astro';
import editions from '../../../news/briefings.json';
const sorted=[...editions].sort((a,b)=>b.date.localeCompare(a.date));
const latest=sorted[0];
---
<NeoLayout
 title="Daily Technology News — AI, Developer Tools, SaaS & Indian Tech | zilu.dev"
 description="Five source-linked technology developments with practical summaries and why they matter. Daily news covering AI, JavaScript, SaaS, cloud security and Indian technology."
 canonical="https://zilu.dev/news/"
 schema={{'@type':'CollectionPage',name:'Daily Technology News',url:'https://zilu.dev/news/',hasPart:sorted.map(e=>({'@type':'NewsArticle',url:'https://zilu.dev/news/'+e.date+'-daily-tech-news/',datePublished:e.date}))}}
>
 {latest ? <NeoNews edition={latest} sorted={sorted}/> : <section class="site-width" aria-label="News status"><h1>Daily technology news</h1><p>Our first edition is coming soon.</p></section>}
</NeoLayout>

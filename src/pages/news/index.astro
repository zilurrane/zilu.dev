---
import Base from '../../layouts/Base.astro';import editions from '../../../news/briefings.json';
const sorted=[...editions].sort((a,b)=>b.date.localeCompare(a.date));const latest=sorted[0];
---
<Base title="Daily Tech News | AI, Developer Tools & Startups — zilu.dev" description="Five carefully selected daily technology stories on AI, developers, SaaS, cybersecurity and Indian markets, with primary source links." canonical="https://zilu.dev/news/" schema={{'@type':'CollectionPage',name:'Daily Tech News',url:'https://zilu.dev/news/'}}>
<div class="wrap"><header class="subhero"><p class="eyebrow">The daily signal</p><h1>Daily <span class="accent">Tech News.</span></h1><p>Five useful stories, an original summary and why they matter. Published with dates and attributed sources.</p></header>{latest&&<section class="section"><div class="section-header"><h2>Latest edition · {latest.date}</h2><a class="accent mini" href={`/news/${latest.date}-daily-tech-news/`}>Full briefing ↗</a></div><div class="card">{latest.stories.map((s,i)=><div class="item"><span class="news-number">{String(i+1).padStart(2,'0')}</span><a href={`/news/${latest.date}-daily-tech-news/`}>{s.headline}</a><p class="muted mini">{s.category}</p></div>)}<p><a class="btn primary" href={`/news/${latest.date}-daily-tech-news/`}>Read today's briefing ↗</a></p></div></section>}<section class="section"><div class="section-header"><h2>Previous editions</h2></div>{sorted.slice(1).map(e=><div class="item"><a href={`/news/${e.date}-daily-tech-news/`}>{e.date} — Daily Tech News ↗</a></div>)}{sorted.length<=1&&<p class="muted">Older editions will appear here as they are published.</p>}</section></div></Base>
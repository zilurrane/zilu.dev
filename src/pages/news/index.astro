---
import Base from '../../layouts/Base.astro';
import editions from '../../../news/briefings.json';
const sorted=[...editions].sort((a,b)=>b.date.localeCompare(a.date));const latest=sorted[0];
---
<Base title="Daily Technology Briefing — AI, Developer Tools, SaaS & India | zilu.dev" description="Five curated technology stories each day with summaries, practical implications and links to original reporting." canonical="https://zilu.dev/news/" schema={{'@type':'CollectionPage',name:'Daily Technology Briefing',url:'https://zilu.dev/news/',hasPart:sorted.map(e=>({'@type':'Article',url:`https://zilu.dev/news/${e.date}-daily-tech-news/`,datePublished:e.date}))}}>
<div class="wrap mock-news-page"><header class="mock-news-hero"><p class="mock-kicker">DAILY TECHNOLOGY BRIEFING</p><h1>Five important<br/>technology stories.<br/><span class="mock-gradient-text">Every morning.</span></h1><p>A concise, source-linked briefing on AI, developer tools, SaaS, cybersecurity and Indian tech & markets.</p></header>
{latest&&<div class="mock-news-layout"><section aria-labelledby="latest-title"><div class="mock-section-heading"><div><p class="mock-kicker">LATEST EDITION</p><h2 id="latest-title"><time datetime={latest.date}>{new Date(latest.date+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></h2></div><a href={`/news/${latest.date}-daily-tech-news/`}>Read full edition →</a></div><div class="mock-news-search"><label class="sr-only" for="news-search">Search stories</label><input id="news-search" type="search" placeholder="Search stories…" autocomplete="off"/></div><div class="mock-news-list" id="filterable-news">{latest.stories.map((s,i)=><article class="mock-news-row" data-category={s.category}><span class="mock-story-index">{String(i+1).padStart(2,'0')}</span><div class="mock-story-content"><small>{s.category}</small><h3><a href={`/news/${latest.date}-daily-tech-news/`}>{s.headline}</a></h3><p>{s.summary}</p><p class="mock-why"><strong>Why it matters:</strong> {s.why_it_matters}</p><a class="mock-source" href={s.source_url} target="_blank" rel="noopener noreferrer">Original source ↗</a></div></article>)}</div><p id="news-empty" class="mock-news-empty" hidden>No stories match your search.</p></section><aside class="mock-news-sidebar"><div class="mock-aside-card"><p class="mock-kicker">EXPLORE</p><h2>Popular topics</h2><div class="mock-chips" aria-label="Filter news by topic"><button type="button" class="mock-topic-button" data-topic="all" aria-pressed="true">All</button>{[...new Set(latest.stories.map(s=>s.category))].map(t=><button type="button" class="mock-topic-button" data-topic={t} aria-pressed="false">{t}</button>)}</div></div><div class="mock-aside-card"><p class="mock-kicker">ARCHIVE</p><h2>Previous editions</h2>{sorted.slice(1).map(e=><p><a href={`/news/${e.date}-daily-tech-news/`}>{e.date} →</a></p>)}{sorted.length===1&&<p>More editions coming soon.</p>}</div></aside></div>}
</div><script>
const search=document.querySelector('#news-search');
const rows=Array.from(document.querySelectorAll('#filterable-news .mock-news-row'));
const topics=Array.from(document.querySelectorAll('[data-topic]'));
let topic='all';
function filterStories(){const q=(search?.value||'').toLocaleLowerCase().trim();let count=0;rows.forEach(row=>{const visible=(topic==='all'||row.dataset.category===topic)&&row.textContent.toLocaleLowerCase().includes(q);row.hidden=!visible;if(visible)count++});const empty=document.querySelector('#news-empty');if(empty)empty.hidden=count!==0}
search?.addEventListener('input',filterStories);
topics.forEach(button=>button.addEventListener('click',()=>{topic=button.dataset.topic||'all';topics.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filterStories()}));
</script></Base>
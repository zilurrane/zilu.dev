---
const {project}=Astro.props;
const diagrams={
'linkedin-signal-agent':{label:'Automated research pipeline',nodes:['RSS + GitHub','Workers AI','Daily digest'],detail:'Collect → score → send'},
'whatsapp-actions':{label:'GitHub Actions integration',nodes:['GitHub CI','Python action','Twilio WhatsApp'],detail:'Workflow → message'},
'ticketing':{label:'Event-driven architecture',nodes:['React client','Node services','NATS events'],detail:'Request → event → update'},
'learnings':{label:'LLM experiments',nodes:['Prompt','LangChain','Model output'],detail:'Explore → test → learn'}
};
const diagram=diagrams[project.slug]||diagrams.learnings;
---
<div class="project-visual" role="img" aria-label={diagram.label+' diagram for '+project.title}>
  <div class="project-visual-top"><span class="project-visual-dots" aria-hidden="true">● ● ●</span><span>{diagram.label}</span></div>
  <div class="project-visual-flow">
    {diagram.nodes.map((node,i)=><Fragment><div class="project-visual-node"><span class="project-visual-node-index">{String(i+1).padStart(2,'0')}</span><strong>{node}</strong></div>{i<diagram.nodes.length-1&&<span class="project-visual-arrow" aria-hidden="true">→</span>}</Fragment>)}
  </div>
  <div class="project-visual-bottom"><span>{diagram.detail}</span><span>ARCHITECTURE DIAGRAM · NOT A SCREENSHOT</span></div>
</div>
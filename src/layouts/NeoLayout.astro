---
import '../styles/neo.css';
import '../styles/neo-inner.css';
const {
  title='Zilu Rane — Full-Stack Engineer',
  description='Full-stack engineering, developer tools and practical technology writing by Zilu Rane.',
  canonical=Astro.url.href,
  type='website',
  schema=null,
  robots='index,follow,max-image-preview:large',
  breadcrumbName=null,
}=Astro.props;
const isNews=Astro.url.pathname.startsWith('/news/');
const portrait='https://zilu.dev/images/zilu-portrait-2026-hd.webp';
const person={
  '@type':'Person','@id':'https://zilu.dev/#person',name:'Zilu Rane',
  image:portrait,jobTitle:'Technical Lead',
  worksFor:{'@type':'Organization',name:'Accion Labs'},
  url:'https://zilu.dev/',
  sameAs:['https://github.com/zilurrane','https://www.linkedin.com/in/zilurane','https://dev.to/zilurrane'],
  knowsAbout:['JavaScript','TypeScript','React','Node.js','Java','Spring Boot','AI agents','Cloud architecture']
};
const site={'@type':'WebSite','@id':'https://zilu.dev/#website',url:'https://zilu.dev/',name:'Zilu Rane',description:'Full-stack engineering, developer tools and technology writing by Zilu Rane.',inLanguage:'en',publisher:{'@id':'https://zilu.dev/#person'}};
const sections=Astro.url.pathname.split('/').filter(Boolean);
const labels={projects:'Projects',writing:'Writing',news:'Daily Tech News',archive:'News Archive',about:'About',resume:'Resume'};
const crumbs=sections.map((part,i)=>({
  '@type':'ListItem',position:i+2,
  name:i===sections.length-1 && breadcrumbName?breadcrumbName:(labels[part]??(/^\d+$/.test(part)?'Page '+part:part.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()))),
  item:'https://zilu.dev/'+sections.slice(0,i+1).join('/')+'/'
}));
const breadcrumb=sections.length && !Astro.url.pathname.startsWith('/404')?{'@type':'BreadcrumbList','@id':new URL(Astro.url.pathname,'https://zilu.dev').href+'#breadcrumbs',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://zilu.dev/'},...crumbs]}:null;
const ld={'@context':'https://schema.org','@graph':[site,person,...(breadcrumb?[breadcrumb]:[]),...(schema?[schema]:[])]};
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="generator" content={Astro.generator}/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="robots" content={robots}/>
  {canonical && !robots.includes("noindex") && <link rel="canonical" href={canonical}/>}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <meta property="og:site_name" content="Zilu Rane"/>
  <meta property="og:locale" content="en_IN"/>
  <meta property="og:type" content={type}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={portrait}/>
  <meta property="og:image:alt" content="Zilu Rane, full-stack engineer"/>
  <meta property="og:image:width" content="1254"/>
  <meta property="og:image:height" content="1254"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={portrait}/>
  <meta name="theme-color" content="#fff2dc" media="(prefers-color-scheme: light)"/>
  <meta name="theme-color" content="#1a1b1a" media="(prefers-color-scheme: dark)"/>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replaceAll('<','\\u003c')}/>
  <script is:inline>
    try {
      const value=localStorage.getItem('zilu-theme');
      document.documentElement.dataset.theme=value==='dark'||value==='light'
        ? value : (matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
    } catch(e) {
      document.documentElement.dataset.theme='light';
    }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="site-width topbar">
    <a aria-label="Zilu Rane home" class="brand" href="/">
      <span class="brand-avatar"><img alt="" src="/images/zilu-portrait-2026-hd.webp" width="40" height="40"/></span>
      <span><span class="brand-name">Zilu Rane <span aria-hidden="true">✳</span></span><span class="brand-sub">FULL-STACK ENGINEER / INDIA</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a class:list={['nav-link',{active:Astro.url.pathname==='/'}]} href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>Home</a>
      <a class:list={['nav-link',{active:Astro.url.pathname.startsWith('/projects/')}]} href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects/')?'page':undefined}>Projects</a>
      <a class:list={['nav-link',{active:Astro.url.pathname.startsWith('/writing/')}]} href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing/')?'page':undefined}>Writing</a>
      <a class:list={['nav-link',{active:isNews}]} href="/news/" aria-current={isNews?'page':undefined}>Daily news</a>
      <a class:list={['nav-link',{active:Astro.url.pathname.startsWith('/about/')}]} href="/about/" aria-current={Astro.url.pathname.startsWith('/about/')?'page':undefined}>About</a>
      <a class:list={['nav-link',{active:Astro.url.pathname.startsWith('/resume/')}]} href="/resume/" aria-current={Astro.url.pathname.startsWith('/resume/')?'page':undefined}>Resume</a>
    </nav>
    <div class="nav-side">
      <span class="status-tag"><span class="live-dot"></span> OPEN TO INTERESTING IDEAS</span>
      <button class="icon-circle theme-toggle" type="button" aria-label="Switch color theme" title="Switch light / dark theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 15.4A9 9 0 0 1 8.6 3.2 9 9 0 1 0 20.8 15.4Z"/></svg>
      </button>
    </div>
  </header>
  <div class="header-rule"></div>
  <main id="main"><slot/></main>
  <footer class="site-width footer" id="about">
    <div><strong>Zilu Rane © {new Date().getFullYear()}</strong>
      <p class="muted">Built with curiosity, thoughtful code and good coffee.</p>
      <p class="foot-note">INDEPENDENT ENGINEERING · SOFTWARE · DAILY TECH BRIEFING</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/">Home</a><a href="/projects/">Projects</a><a href="/writing/">Writing</a><a href="/news/">News</a>
      <a href="/about/">About</a><a href="/resume/">Resume</a>
      <a href="https://github.com/zilurrane" rel="noopener noreferrer" target="_blank">GitHub ↗</a>
      <a href="mailto:zilurrane@gmail.com">Email ↗</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
  </footer>
  <script is:inline>
    (() => {
      const root=document.documentElement;
      const iconDark='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
      const iconLight='<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20.8 15.4A9 9 0 0 1 8.6 3.2 9 9 0 1 0 20.8 15.4Z"/></svg>';
      function paint(){
        const dark=root.dataset.theme==='dark';
        document.querySelectorAll('.theme-toggle').forEach(button=>{
          button.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
          button.title=dark?'Switch to light theme':'Switch to dark theme';
          button.innerHTML=dark?iconDark:iconLight;
        });
      }
      document.querySelectorAll('.theme-toggle').forEach(button=>button.addEventListener('click',()=>{
        const theme=root.dataset.theme==='dark'?'light':'dark';
        root.dataset.theme=theme;
        try{localStorage.setItem('zilu-theme',theme)}catch(e){}
        paint();
      }));
      paint();
    })();
  </script>
</body>
</html>

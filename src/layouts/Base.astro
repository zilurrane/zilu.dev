---
import '../styles/global.css';
const {title='Zilu Rane — Full-Stack Engineer',description='Zilu Rane builds full-stack software, AI agents and developer tools.',canonical=Astro.url.href,type='website',schema=null,robots='index,follow,max-image-preview:large'} = Astro.props;
const nav=[['/','Home'],['/projects/','Work'],['/writing/','Writing'],['/news/','News'],['/about/','About'],['/resume/','Resume']];
const person={'@type':'Person','@id':'https://zilu.dev/#person',name:'Zilu Rane',jobTitle:'Technical Lead',worksFor:{'@type':'Organization',name:'Accion Labs'},url:'https://zilu.dev/',sameAs:['https://github.com/zilurrane','https://www.linkedin.com/in/zilurane','https://dev.to/zilurrane'],knowsAbout:['JavaScript','TypeScript','React','Node.js','AI agents','RAG','Cloudflare Workers']};
const ld={'@context':'https://schema.org','@graph':[person,...(schema?[schema]:[])]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content={Astro.generator}/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><meta property="og:type" content={type}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(ld).replaceAll('<','\\u003c')}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('zilu-theme')||'light'}catch{}</script></head>
<body><a href="#main" style="position:absolute;left:-9999px" onfocus="this.style.left='12px'" onblur="this.style.left='-9999px'">Skip to content</a>
<header class="site-head"><div class="nav wrap"><a class="brand" href="/"><span class="accent">zilu</span>.dev ✦</a><nav class="nav-links" aria-label="Main navigation">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}<button id="theme" class="btn" aria-label="Toggle color theme">☼</button><a href="mailto:zilurrane@gmail.com" class="btn primary">Let's connect ↗</a></nav><details id="mobile-nav" class="mobile-menu"><summary class="btn">☰ Menu</summary><nav aria-label="Mobile navigation">{nav.map(([href,label])=><a href={href}>{label}</a>)}<a href="mailto:zilurrane@gmail.com">Contact</a><button id="theme-mobile" class="btn">Toggle theme</button></nav></details></div></header>
<main id="main"><slot/></main><footer class="footer"><div class="wrap footer-row"><div><strong><span class="accent">zilu</span>.dev</strong> <span class="muted mini">· Built in Pune · Full-stack engineering & AI</span></div><div class="mini"><a href="https://github.com/zilurrane">GitHub</a> &nbsp;·&nbsp; <a href="https://www.linkedin.com/in/zilurane">LinkedIn</a> &nbsp;·&nbsp; <a href="mailto:zilurrane@gmail.com">Email</a> &nbsp;·&nbsp; <a href="/sitemap-index.xml">Sitemap</a></div></div></footer>
<script is:inline>for(const id of ['theme','theme-mobile'])document.getElementById(id)?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('zilu-theme',next)}catch{}});</script>
</body></html>

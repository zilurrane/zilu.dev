---
import '../styles/global.css';
import '../styles/portfolio-polish.css';
import '../styles/editorial-home.css';
import '../styles/editorial-news.css';
const {title='Zilu Rane — Full-Stack Engineer',description='Zilu Rane builds full-stack software, AI agents and developer tools.',canonical=Astro.url.href,type='website',schema=null,robots='index,follow,max-image-preview:large'} = Astro.props;
const nav=[['/','Home'],['/projects/','Work'],['/writing/','Writing'],['/news/','News'],['/about/','About']];
const person={'@type':'Person','@id':'https://zilu.dev/#person',name:'Zilu Rane',image:'https://zilu.dev/images/zilu-cutout.webp',jobTitle:'Technical Lead',worksFor:{'@type':'Organization',name:'Accion Labs'},url:'https://zilu.dev/',sameAs:['https://github.com/zilurrane','https://www.linkedin.com/in/zilurane','https://dev.to/zilurrane'],knowsAbout:['JavaScript','TypeScript','React','Node.js','AI agents','RAG','Cloudflare Workers']};
const ld={'@context':'https://schema.org','@graph':[person,...(schema?[schema]:[])]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content={Astro.generator}/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><meta property="og:type" content={type}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><meta name="theme-color" content="#101114" media="(prefers-color-scheme: dark)"/><meta name="theme-color" content="#fafbfe" media="(prefers-color-scheme: light)"/><script type="application/ld+json" set:html={JSON.stringify(ld).replaceAll('<','\\u003c')}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('zilu-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head>
<body><a href="#main" style="position:absolute;left:-9999px" onfocus="this.style.left='12px'" onblur="this.style.left='-9999px'">Skip to content</a>
<header class="site-head"><div class="nav wrap"><a class="brand" href="/" aria-label="Zilu Rane — homepage"><span class="brand-full">ZILU<span class="brand-dot">.DEV</span></span></a><nav class="nav-links" aria-label="Main navigation">{nav.map(([href,label])=><a href={href} aria-current={(href==='/'?Astro.url.pathname===href:Astro.url.pathname.startsWith(href))?'page':undefined}>{label}</a>)}<a class="nav-search" href="/news/" aria-label="Search technology news"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 5 5"/></svg></a><button id="theme" class="btn theme-toggle" aria-label="Switch to dark theme">☾</button><a href="mailto:zilurrane@gmail.com" class="btn primary">Let's connect ↗</a></nav><a class="nav-search nav-mobile-search" href="/news/" aria-label="Search technology news"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 5 5"/></svg></a><details id="mobile-nav" class="mobile-menu"><summary class="btn">☰ Menu</summary><nav aria-label="Mobile navigation">{nav.map(([href,label])=><a href={href}>{label}</a>)}<a href="mailto:zilurrane@gmail.com">Contact</a><button id="theme-mobile" class="btn theme-toggle" aria-label="Switch to dark theme">☾</button></nav></details></div></header>
<main id="main"><slot/></main><footer class="footer"><div class="wrap footer-row"><div><strong><span class="accent">zilu</span>.dev</strong> <span class="muted mini">· Built in Pune · Full-stack engineering & AI</span></div><div class="mini"><a href="https://github.com/zilurrane">GitHub</a> &nbsp;·&nbsp; <a href="https://www.linkedin.com/in/zilurane">LinkedIn</a> &nbsp;·&nbsp; <a href="mailto:zilurrane@gmail.com">Email</a> &nbsp;·&nbsp; <a href="/sitemap-index.xml">Sitemap</a></div></div></footer>
<script is:inline>
const themeButtons=['theme','theme-mobile'].map(id=>document.getElementById(id)).filter(Boolean);
function applyTheme(mode){document.documentElement.dataset.theme=mode;themeButtons.forEach(button=>{button.textContent=mode==='dark'?'☀':'☾';button.setAttribute('aria-label',mode==='dark'?'Switch to light theme':'Switch to dark theme')})}
applyTheme(document.documentElement.dataset.theme);
themeButtons.forEach(button=>button.addEventListener('click',()=>{const mode=document.documentElement.dataset.theme==='dark'?'light':'dark';applyTheme(mode);try{localStorage.setItem('zilu-theme',mode)}catch{}}));
</script>
</body></html>
